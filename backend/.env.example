# Server Configuration
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_PATH=./data/churnguard.db

# Authentication
# In DEMO_MODE=true, authentication is bypassed / uses default demo user so judges need no login
DEMO_MODE=true
JWT_SECRET=churnguard-hackathon-insecure-dev-jwt-secret-replace-in-prod
DEMO_USER_EMAIL=demo@churnguard.local
DEMO_USER_PASSWORD=demopassword

# PayPal Configuration (SANDBOX ONLY)
# HARD SAFETY RULE: The server will refuse to start if PAYPAL_ENV is not "sandbox"
PAYPAL_ENV=sandbox

# When MOCK_PAYPAL=true, an in-memory realistic fake PayPal client is used with no external network calls.
# Set MOCK_PAYPAL=false to use real PayPal Sandbox API calls.
MOCK_PAYPAL=true

# PayPal Sandbox Credentials (fill these when MOCK_PAYPAL=false)
# Get from PayPal Developer Dashboard -> Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here

# PayPal Webhook ID (used for signature verification in real mode)
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here

# PayPal Subscription Return & Cancel URLs (must be https or valid public redirect)
PAYPAL_RETURN_URL=https://example.com/return
PAYPAL_CANCEL_URL=https://example.com/cancel


