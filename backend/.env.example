# ==============================================================================
# Sentinel Backend - Environment Configuration (.env.example)
# Copy this file to .env and fill in your values
# ==============================================================================

# Server Port (default 3000)
PORT=3000

# Frontend URL for CORS protection
FRONTEND_URL=http://localhost:5173

# Demo Mode Fallback:
# When true, all PayPal pause/cancel/undo calls are simulated locally in SQLite.
# Set to false when testing with real PayPal Sandbox API credentials.
DEMO_MODE=true

# SQLite Database File Path (defaults to ./sentinel.db)
DATABASE_PATH=./sentinel.db

# ==============================================================================
# PayPal Subscriptions API (SANDBOX ONLY - Never use live keys)
# Obtain these from: https://developer.paypal.com/dashboard/applications/sandbox
# ==============================================================================
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal Webhook ID (used for signature verification in real sandbox mode)
# Create a webhook in the PayPal Developer Dashboard pointing to your /webhooks/paypal URL
PAYPAL_WEBHOOK_ID=
